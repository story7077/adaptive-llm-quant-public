{
  "$defs": {
    "PortfolioIntegrationMode": {
      "enum": [
        "ADD_SLEEVE",
        "REPLACE_SLEEVE"
      ],
      "title": "PortfolioIntegrationMode",
      "type": "string"
    },
    "RiskFreeSeriesMode": {
      "enum": [
        "SERIES",
        "EXPLICIT_ZERO"
      ],
      "title": "RiskFreeSeriesMode",
      "type": "string"
    },
    "StationaryBootstrapContractV1": {
      "additionalProperties": false,
      "properties": {
        "configured_seed": {
          "minimum": 0,
          "title": "Configured Seed",
          "type": "integer"
        },
        "expected_block_sessions": {
          "maximum": 252,
          "minimum": 1,
          "title": "Expected Block Sessions",
          "type": "integer"
        },
        "lower_quantile": {
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "title": "Lower Quantile",
          "type": "number"
        },
        "samples": {
          "maximum": 100000,
          "minimum": 100,
          "title": "Samples",
          "type": "integer"
        },
        "schema_version": {
          "default": "stationary_bootstrap_contract_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "variance_epsilon": {
          "exclusiveMinimum": 0,
          "title": "Variance Epsilon",
          "type": "number"
        }
      },
      "required": [
        "configured_seed",
        "samples",
        "expected_block_sessions",
        "lower_quantile",
        "variance_epsilon"
      ],
      "title": "StationaryBootstrapContractV1",
      "type": "object"
    }
  },
  "$id": "https://adaptive-llm-quant.example/schemas/portfolio-comparison-contract-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allocation_policy_created_at": {
      "format": "date-time",
      "title": "Allocation Policy Created At",
      "type": "string"
    },
    "allocation_policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Allocation Policy Hash",
      "type": "string"
    },
    "allocation_policy_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Allocation Policy Version",
      "type": "string"
    },
    "annualization_sessions": {
      "maximum": 366,
      "minimum": 1,
      "title": "Annualization Sessions",
      "type": "integer"
    },
    "bootstrap_contract": {
      "$ref": "#/$defs/StationaryBootstrapContractV1"
    },
    "candidate_artifact_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Artifact Hash",
      "type": "string"
    },
    "candidate_portfolio_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Portfolio Manifest Hash",
      "type": "string"
    },
    "candidate_risk_budget": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Candidate Risk Budget",
      "type": "number"
    },
    "champion_portfolio_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Champion Portfolio Manifest Hash",
      "type": "string"
    },
    "common_session_policy": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Common Session Policy",
      "type": "string"
    },
    "comparison_contract_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Comparison Contract Id",
      "type": "string"
    },
    "contract_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Hash",
      "type": "string"
    },
    "cost_model_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cost Model Hash",
      "type": "string"
    },
    "cost_stress_multipliers": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Cost Stress Multipliers",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_contract_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Execution Contract Hash",
      "type": "string"
    },
    "integration_mode": {
      "$ref": "#/$defs/PortfolioIntegrationMode"
    },
    "market_data_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Market Data Manifest Hash",
      "type": "string"
    },
    "maximum_absolute_daily_return": {
      "exclusiveMinimum": 0,
      "title": "Maximum Absolute Daily Return",
      "type": "number"
    },
    "risk_free_series_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Risk Free Series Manifest Hash",
      "type": "string"
    },
    "risk_free_series_mode": {
      "$ref": "#/$defs/RiskFreeSeriesMode"
    },
    "schema_version": {
      "default": "portfolio_comparison_contract_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sleeve_replaced_or_added": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Sleeve Replaced Or Added",
      "type": "string"
    },
    "starting_nav": {
      "exclusiveMinimum": 0,
      "title": "Starting Nav",
      "type": "number"
    },
    "weight_selection_data_cutoff": {
      "format": "date-time",
      "title": "Weight Selection Data Cutoff",
      "type": "string"
    }
  },
  "required": [
    "comparison_contract_id",
    "champion_portfolio_manifest_hash",
    "candidate_portfolio_manifest_hash",
    "candidate_artifact_hash",
    "allocation_policy_version",
    "allocation_policy_hash",
    "integration_mode",
    "sleeve_replaced_or_added",
    "candidate_risk_budget",
    "weight_selection_data_cutoff",
    "allocation_policy_created_at",
    "starting_nav",
    "market_data_manifest_hash",
    "execution_contract_hash",
    "cost_model_hash",
    "risk_free_series_manifest_hash",
    "risk_free_series_mode",
    "common_session_policy",
    "annualization_sessions",
    "bootstrap_contract",
    "cost_stress_multipliers",
    "maximum_absolute_daily_return",
    "created_at",
    "contract_hash"
  ],
  "title": "PortfolioComparisonContractV1",
  "type": "object"
}
