{
  "$id": "https://adaptive-llm-quant.example/schemas/meta-oos-commander-binding-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Binding Hash",
      "type": "string"
    },
    "model_family": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Model Family",
      "type": "string"
    },
    "model_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Model Version",
      "type": "string"
    },
    "output_schema_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Schema Hash",
      "type": "string"
    },
    "prompt_template_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prompt Template Hash",
      "type": "string"
    },
    "reasoning_profile": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Reasoning Profile",
      "type": "string"
    },
    "request_schema_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Schema Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "meta_oos_commander_binding_v1",
      "default": "meta_oos_commander_binding_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "model_family",
    "model_version",
    "reasoning_profile",
    "prompt_template_hash",
    "request_schema_hash",
    "output_schema_hash",
    "binding_hash"
  ],
  "title": "MetaOosCommanderBindingV1",
  "type": "object"
}
