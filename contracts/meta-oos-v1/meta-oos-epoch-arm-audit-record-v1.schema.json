{
  "$defs": {
    "MetaOosPolicyArm": {
      "enum": [
        "STATIC_CHAMPION",
        "FIXED_RECALIBRATION",
        "MEMORYLESS_COMMANDER",
        "ADAPTIVE_META_CONTROLLER"
      ],
      "title": "MetaOosPolicyArm",
      "type": "string"
    }
  },
  "$id": "https://adaptive-llm-quant.example/schemas/meta-oos-epoch-arm-audit-record-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm": {
      "$ref": "#/$defs/MetaOosPolicyArm"
    },
    "candidate_artifact_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Artifact Hash"
    },
    "candidate_count": {
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Decision Hash",
      "type": "string"
    },
    "epoch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Epoch Id",
      "type": "string"
    },
    "experiment_count": {
      "minimum": 0,
      "title": "Experiment Count",
      "type": "integer"
    },
    "memory_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Snapshot Hash"
    },
    "oos_use_count": {
      "minimum": 0,
      "title": "Oos Use Count",
      "type": "integer"
    },
    "outcome_available_at": {
      "format": "date-time",
      "title": "Outcome Available At",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Plan Id",
      "type": "string"
    },
    "positive_matured_outcome_count": {
      "minimum": 0,
      "title": "Positive Matured Outcome Count",
      "type": "integer"
    },
    "private_outcome_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Private Outcome Hash",
      "type": "string"
    },
    "promotion_eligible_count": {
      "minimum": 0,
      "title": "Promotion Eligible Count",
      "type": "integer"
    },
    "real_order_routing": {
      "const": false,
      "default": false,
      "title": "Real Order Routing",
      "type": "boolean"
    },
    "record_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Hash",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "meta_oos_epoch_arm_audit_record_v1",
      "default": "meta_oos_epoch_arm_audit_record_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_count": {
      "minimum": 2,
      "title": "Session Count",
      "type": "integer"
    },
    "technical_failure_count": {
      "minimum": 0,
      "title": "Technical Failure Count",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "plan_id",
    "plan_hash",
    "epoch_id",
    "arm",
    "decision_hash",
    "private_outcome_hash",
    "session_count",
    "experiment_count",
    "candidate_count",
    "oos_use_count",
    "positive_matured_outcome_count",
    "technical_failure_count",
    "promotion_eligible_count",
    "outcome_available_at",
    "created_at",
    "record_hash"
  ],
  "title": "MetaOosEpochArmAuditRecordV1",
  "type": "object"
}
