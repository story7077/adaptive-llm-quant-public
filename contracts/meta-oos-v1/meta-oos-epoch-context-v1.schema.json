{
  "$defs": {
    "MetaOosPolicyArm": {
      "enum": [
        "STATIC_CHAMPION",
        "FIXED_RECALIBRATION",
        "MEMORYLESS_COMMANDER",
        "ADAPTIVE_META_CONTROLLER"
      ],
      "title": "MetaOosPolicyArm",
      "type": "string"
    }
  },
  "$id": "https://adaptive-llm-quant.example/schemas/meta-oos-epoch-context-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm": {
      "$ref": "#/$defs/MetaOosPolicyArm"
    },
    "available_candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Available Candidate Ids",
      "type": "array"
    },
    "context_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Context Hash",
      "type": "string"
    },
    "context_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Context Key",
      "type": "string"
    },
    "decision_at": {
      "format": "date-time",
      "title": "Decision At",
      "type": "string"
    },
    "epoch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Epoch Id",
      "type": "string"
    },
    "market_data_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Market Data Manifest Hash",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "meta_oos_epoch_context_v1",
      "default": "meta_oos_epoch_context_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_hash",
    "epoch_id",
    "arm",
    "decision_at",
    "context_key",
    "market_data_manifest_hash",
    "available_candidate_ids",
    "context_hash"
  ],
  "title": "MetaOosEpochContextV1",
  "type": "object"
}
