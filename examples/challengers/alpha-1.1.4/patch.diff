+def test_canonical_hash_rounds_floats_and_preserves_array_order() -> None:
+    left = {
+        "z": [1.23456789012345, 9.87654321098765],
+        "a": {"integer": 7, "flag": True, "nothing": None},
+    }
+    reordered_keys = {"a": left["a"], "z": left["z"]}
+    reversed_array = {"a": left["a"], "z": list(reversed(left["z"]))}
+
+    assert model._canonical_sha256(left) == _canonical_hash(left)
+    assert model._canonical_sha256(left) == model._canonical_sha256(reordered_keys)
+    assert model._canonical_sha256(left) != model._canonical_sha256(reversed_array)
+    with pytest.raises(ValueError):
+        model._canonical_sha256({"bad": float("inf")})
