+def _canonical_hash(value: Any) -> str:
+    payload = json.dumps(
+        _canonicalize(value),
+        ensure_ascii=False,
+        allow_nan=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
